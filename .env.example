# Directory ChatGPT is allowed to access. Required.
MCP_ROOT=~/Projects

# Bind locally; do not expose 0.0.0.0 unless you know why.
MCP_HOST=127.0.0.1
MCP_PORT=8008

# Optional but strongly recommended when using a tunnel.
# Generate: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Maximum file size for read/write/search operations.
MCP_MAX_FILE_BYTES=5242880

# Set to true only if you explicitly want destructive tools.
MCP_ENABLE_DELETE=false
